# ============================================
# AI Video Cutter — Environment configuration
# Copie este arquivo para ".env" na raiz e ajuste
# os valores conforme necessário.
# ============================================

# ---------- Backend ----------
PORT=3333

# Caminho para a pasta de armazenamento local (relativo à raiz do backend
# ou absoluto). Todos os vídeos, thumbnails, transcrições e cortes
# são salvos aqui.
STORAGE_PATH=../../storage

# Caminho para os binários do FFmpeg/FFprobe. Se estiverem no PATH do
# sistema, o valor padrão ("ffmpeg" / "ffprobe") já funciona.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Binário yt-dlp para baixar vídeos de YouTube/Vimeo/etc.
# URLs diretas de arquivo (.mp4) funcionam sem yt-dlp.
YT_DLP_PATH=yt-dlp
# Navegador preferido para cookies em vídeos com age-gate (chrome|edge|firefox).
# Feche o navegador antes de baixar — no Windows o DB de cookies fica bloqueado.
YT_DLP_BROWSER=chrome
# Opcional: cookies.txt (Netscape). Mais confiável que --cookies-from-browser.
# YT_DLP_COOKIES_FILE=
# ---------- IA / Whisper (Fases 2–3) ----------
# Chave OpenAI para Whisper API + análise de momentos (opcional).
# Sem chave: usa whisper CLI se disponível, senão modo heurístico.
OPENAI_API_KEY=

# auto | openai | ffmpeg | cli | heuristic
WHISPER_MODE=auto
WHISPER_CLI_PATH=whisper
# Modelo whisper.cpp (ggml-*.bin) — usado pelo FFmpeg local
WHISPER_MODEL_PATH=
DEFAULT_LANGUAGE=pt-BR

# Tamanho máximo de upload em megabytes.
MAX_UPLOAD_SIZE_MB=2048

# URL do frontend, usada para configurar o CORS do backend.
FRONTEND_URL=http://localhost:3030

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:3333
